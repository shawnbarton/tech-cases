#!/bin/bash
# stuttertest: run and record docked-stutter experiments on KDE Plasma (KWin)
# with an NVIDIA GPU driving the external monitors.
#
#   stuttertest info                       save a system/driver/KWin state report
#   stuttertest kwin show                  login-script settings vs. the running session
#   stuttertest kwin install               install the login script into Plasma's env dir
#   stuttertest kwin set KEY=VALUE...      gpu=default|nvidia  tb=default|on|off  margin=default|<us>
#                                          cursor=default|sw  repaint=default|full  perf=on|off  lidcheck=on|off
#                                          (then log out and in)
#   stuttertest run NAME [options]         measure one test while you use the desktop, then
#                                          record whether you saw stutter / static corruption
#       --clock LIST   comma-separated: none, mem[=MHz], gr[=MHz], pm-consistent, pm-max,
#                      p0 (load that holds the NVIDIA GPU at full power), p0ctl (same load on the Intel GPU)
#       --trace        also record a kernel trace of KWin's commits and NVIDIA's flip events
#                      (bpftrace, root, testbed/trace/flipfence.bt); not together with --smi
#       --smi          also log nvidia-smi P-state/clocks every 500 ms (adds GPU polling);
#                      outside Plasma (GNOME, COSMIC) this is the only measurement
#       --duration N   stop after N seconds instead of waiting for Enter
#       --force        run even if the nvidia-clockfloor service holds a lock
#                      While it runs, mark each moment you see static or blanking with a keyboard
#                      shortcut bound to 'stuttertest mark' (KWin runs global shortcuts even while
#                      you drag a window), or press Enter in the terminal after letting go.
#   stuttertest mark [TEXT]                mark "static seen now" (bind it to a keyboard shortcut)
#   stuttertest report                     table of all runs
#   stuttertest analyze [RUN]              where the late frames come from (default: last run)
#   stuttertest reset                      undo any clock lock, PowerMizer mode or load
#
# Results go to ~/stuttertest (override with STUTTERTEST_DIR).
set -u

HERE=$(dirname "$(readlink -f "$0")")
DATA=${STUTTERTEST_DIR:-$HOME/stuttertest}
ENVFILE=$HOME/.config/plasma-workspace/env/50-kwin-docked-gpu.sh
ENVSRC=$HERE/../kwin/50-kwin-docked-gpu.sh
SUMMARY=$HERE/kwin-perf-summary
ANALYZE=$HERE/stutter-analyze
NV_HEADS=$HERE/nv-heads
POWERMIZER=$HERE/nv-powermizer
DGPU_RUN=$HERE/dgpu-run
NV_PCI=0000:01:00.0
IG_RENDER=/dev/dri/by-path/pci-0000:00:02.0-render
SMI_ID=0

die() { echo "stuttertest: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
mono_ns() { python3 -c 'import time; print(time.monotonic_ns())'; }
kwin_pid() { pgrep -u "$(id -u)" -xn kwin_wayland; }
# Some distros (Fedora among them) install kwin_wayland with file capabilities
# (CAP_SYS_NICE), which makes its /proc entries root-only even for its owner.
# Then fall back to the systemd user environment KWin was started from (Plasma
# imports the login-script variables there) and to its working directory.
kwin_proc_ok() {
    local p
    p=$(kwin_pid) || return 1
    [ -z "${STUTTERTEST_NO_PROC:-}" ] && [ -r "/proc/$p/environ" ]
}
kwin_env() {
    local p
    p=$(kwin_pid) || return 0
    if kwin_proc_ok; then
        tr '\0' '\n' < "/proc/$p/environ" | grep '^KWIN_' || true
    else
        systemctl --user show-environment 2>/dev/null | grep '^KWIN_' || true
    fi
}
kwin_env_source() { if kwin_proc_ok; then echo "KWin process"; else echo "systemd user environment (KWin's /proc entries are root-only)"; fi; }
kwin_workdir() {
    local wd
    wd=$(systemctl --user show -p WorkingDirectory --value plasma-kwin_wayland.service 2>/dev/null)
    wd=${wd#[-!]}
    wd=${wd//%h/$HOME}
    case $wd in ''|'~') wd=$HOME ;; esac
    echo "$wd"
}

# The frame logs of the running KWin: the files it has open if /proc allows,
# otherwise the logs in its working directory written since it started.
kwin_csv_files() {
    local p fd t dir found='' start
    p=$(kwin_pid) || return 0
    if kwin_proc_ok; then
        for fd in /proc/"$p"/fd/*; do
            t=$(readlink "$fd" 2>/dev/null) || continue
            case $t in */'kwin perf statistics '*.csv) printf '%s\n' "$t"; found=1 ;; esac
        done
        [ -n "$found" ] && return 0
        dir=$(readlink "/proc/$p/cwd")
    else
        dir=$(kwin_workdir)
    fi
    start=$(( $(date +%s) - $(ps -o etimes= -p "$p" | tr -dc '0-9') - 2 ))
    for t in "$dir"/kwin\ perf\ statistics\ *.csv; do
        [ -e "$t" ] && [ "$(stat -c %Y "$t")" -ge "$start" ] && printf '%s\n' "$t"
    done
    return 0
}

kwin_support() {
    if have dbus-send; then
        dbus-send --session --print-reply --dest=org.kde.KWin /KWin org.kde.KWin.supportInformation 2>/dev/null
    elif have qdbus6; then
        qdbus6 org.kde.KWin /KWin org.kde.KWin.supportInformation 2>/dev/null
    elif have qdbus-qt6; then
        qdbus-qt6 org.kde.KWin /KWin org.kde.KWin.supportInformation 2>/dev/null
    elif have busctl; then
        busctl --user --json=short call org.kde.KWin /KWin org.kde.KWin supportInformation 2>/dev/null \
            | python3 -c 'import json, sys; print(json.load(sys.stdin)["data"][0])' 2>/dev/null
    fi
}
render_gpu() { kwin_support | sed -n 's/.*OpenGL renderer string:[[:space:]]*//p' | head -1 | tr -d '"'; }

module_type() {
    case $(modinfo -F license nvidia 2>/dev/null) in
        NVIDIA) echo closed ;;
        '') echo none ;;
        *) echo open ;;
    esac
}
gsp_state() {
    local v
    v=$(nvidia-smi -q 2>/dev/null | sed -n 's/^[[:space:]]*GSP Firmware Version[[:space:]]*:[[:space:]]*//p' | head -1)
    case $v in ''|N/A) echo off ;; *) echo "on ($v)" ;; esac
}
# n/a: this driver has no such parameter (vblank is 610+); root-only: 580 makes them 0400 and sudo isn't cached
drm_param() {
    local f=/sys/module/nvidia_drm/parameters/$1
    [ -d /sys/module/nvidia_drm ] || { echo unloaded; return; }
    [ -e "$f" ] || { echo n/a; return; }
    cat "$f" 2>/dev/null || sudo -n cat "$f" 2>/dev/null || echo root-only
}
power_profile() {
    local p
    p=$(busctl --system get-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile 2>/dev/null | cut -d'"' -f2)
    [ -n "$p" ] || p=$(powerprofilesctl get 2>/dev/null)
    echo "${p:-?}"
}
powerd_state() { systemctl is-active nvidia-powerd.service 2>/dev/null || true; }
lid_state() { sed 's/.*:[[:space:]]*//' /proc/acpi/button/lid/*/state 2>/dev/null | head -1; }
kwin_version() { kwin_wayland --version 2>/dev/null | awk '{print $2}'; }
# X11 apps (through Xwayland) open right now; don't start Xwayland just to ask
x11_apps() {
    local a
    pgrep -x Xwayland >/dev/null || { echo none; return; }
    have xlsclients || { echo '?'; return; }
    a=$(xlsclients 2>/dev/null | awk '{print $2}' | sed 's#.*/##' | sort -u | paste -sd, -)
    echo "${a:-none}"
}
add_mark() { mkdir -p "$DATA"; echo "$(mono_ns) ${*:-static}" >> "$DATA/marks.log"; }

docked() {
    local c
    for c in /sys/bus/pci/devices/"$NV_PCI"/drm/card*/card*-*; do
        [ -r "$c/status" ] || continue
        case ${c##*/} in *-eDP-*|*-LVDS-*|*-DSI-*) continue ;; esac
        [ "$(cat "$c/status")" = connected ] && return 0
    done
    return 1
}

# ---------------------------------------------------------------- info

cmd_info() {
    mkdir -p "$DATA"
    local out
    out="$DATA/info-$(date +%Y%m%d-%H%M%S).txt"
    {
        echo "== stuttertest info $(date -Is)"
        grep -m1 PRETTY_NAME /etc/os-release
        echo "kernel: $(uname -r)"
        echo "cmdline: $(cat /proc/cmdline)"
        kwin_wayland --version 2>/dev/null
        plasmashell --version 2>/dev/null
        Xwayland -version 2>&1 | grep -m1 -i version
        echo; echo "== NVIDIA"
        head -1 /proc/driver/nvidia/version 2>/dev/null
        nvidia-smi --query-gpu=name,driver_version,pstate,clocks.mem,clocks.gr,power.draw,pcie.link.gen.current,pcie.link.width.current --format=csv 2>&1
        echo "kernel module: $(module_type)   GSP: $(gsp_state)"
        grep -E 'EnableGpuFirmware|DynamicPowerManagement|PreserveVideoMemoryAllocations|UseKernelSuspendNotifiers|RegistryDwords' /proc/driver/nvidia/params 2>/dev/null
        echo "nvidia_drm: modeset=$(drm_param modeset) fbdev=$(drm_param fbdev) vblank=$(drm_param vblank)"
        echo "nvidia-powerd (Dynamic Boost): $(powerd_state)"
        echo "runtime PM: $(cat /sys/bus/pci/devices/$NV_PCI/power/control 2>/dev/null) / $(cat /sys/bus/pci/devices/$NV_PCI/power/runtime_status 2>/dev/null)"
        [ -e /run/nvidia-clockfloor.state ] && echo "nvidia-clockfloor active: $(cat /run/nvidia-clockfloor.state)"
        echo; echo "== Displays"
        ls -l /dev/dri/by-path/
        for s in /sys/class/drm/card*-*/status; do echo "${s%/status} $(cat "$s")"; done | sed 's#/sys/class/drm/##'
        if have kscreen-doctor; then kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g'; fi
        echo "docked: $(docked && echo yes || echo no)   AC: $(systemd-ac-power 2>/dev/null && echo yes || echo no)   lid: $(lid_state)"
        echo "What the NVIDIA display engine sends (30bpp = 10 bits per colour, 24bpp = 8):"
        "$NV_HEADS" 2>&1 | sed 's/^/  /'
        local ef; ef=$(cat /sys/module/drm/parameters/edid_firmware 2>/dev/null); case $ef in ''|,) ef=none ;; esac
        echo "EDID file override: boot '$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^drm.edid_firmware=//p')'  now: $ef"
        echo; echo "== KWin session"
        echo "render GPU: $(render_gpu)"
        echo "KWIN_* in running KWin (from the $(kwin_env_source)):"; kwin_env | sed 's/^/  /'
        echo "KWIN_* in systemd user environment:"; systemctl --user show-environment 2>/dev/null | grep '^KWIN_' | sed 's/^/  /'
        echo "login script: $( [ -e "$ENVFILE" ] && grep '^KD_' "$ENVFILE" | paste -sd' ' || echo 'not installed')"
        echo "frame logs open: $(kwin_csv_files | paste -sd' ')"
        echo; echo "== Possible GPU pollers running"
        pgrep -a -f 'nvtop|mangohud|nvidia-smi|gwe|coolercontrol|tuxedo-control-center|btop' | grep -v pgrep || echo "  none found"
        echo; echo "== Power and platform"
        sed 's/^/platform profile: /' /sys/firmware/acpi/platform_profile 2>/dev/null
        echo "power profile: $(power_profile)"
        echo "CPU microcode: $(grep -m1 microcode /proc/cpuinfo | sed 's/.*: //')"
        echo "DMI: $(cat /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/board_name /sys/class/dmi/id/bios_version 2>/dev/null | paste -sd' ')"
        have mokutil && mokutil --sb-state 2>/dev/null
        have boltctl && boltctl list 2>/dev/null | grep -E 'name|status|authflags'
    } 2>&1 | tee "$out"
    echo; echo "saved: $out"
}

# ---------------------------------------------------------------- kwin

# The installed login script predates a setting: install the current one, keeping its KD_
# values. The old file is kept next to it, and lines the template doesn't have are listed.
upgrade_envfile() {
    local bak tmp
    bak=$ENVFILE.bak-$(date +%Y%m%d-%H%M%S)
    cp "$ENVFILE" "$bak"
    tmp=$(mktemp)
    python3 -I - "$ENVSRC" "$bak" "$tmp" <<'EOF'
import re, sys
src, old, out = sys.argv[1:4]
tpl = open(src).read().splitlines()
prev = open(old).read().splitlines()
vals = {m.group(1): l for l in prev if (m := re.match(r"(KD_[A-Z_]+)=", l))}
res = [vals.get(m.group(1), l) if (m := re.match(r"(KD_[A-Z_]+)=", l)) else l for l in tpl]
open(out, "w").write("\n".join(res) + "\n")
extra = [l for l in prev if l.strip() and l not in tpl and not re.match(r"KD_[A-Z_]+=", l)]
for l in extra:
    print(f"  not carried over: {l}")
EOF
    install -m 0644 "$tmp" "$ENVFILE"
    rm -f "$tmp"
    echo "updated $ENVFILE to the current version (KD_ settings kept; old file: $bak)"
}

cmd_kwin() {
    local sub=${1:-show}; shift || true
    case $sub in
        install)
            [ -r "$ENVSRC" ] || die "missing $ENVSRC"
            mkdir -p "$(dirname "$ENVFILE")"
            if [ -e "$ENVFILE" ] && [ "${1:-}" != --force ]; then
                echo "already installed: $ENVFILE (use: stuttertest kwin install --force to overwrite)"
            else
                install -m 0644 "$ENVSRC" "$ENVFILE" && echo "installed: $ENVFILE (all options off)"
            fi ;;
        set)
            [ -e "$ENVFILE" ] || cmd_kwin install
            local kv k v var val
            for kv in "$@"; do
                k=${kv%%=*}; v=${kv#*=}
                case $k=$v in
                    gpu=default) var=KD_GPU; val= ;;
                    gpu=nvidia) var=KD_GPU; val=nvidia ;;
                    tb=default) var=KD_TRIPLE_BUFFERING; val= ;;
                    tb=on) var=KD_TRIPLE_BUFFERING; val=1 ;;
                    tb=off) var=KD_TRIPLE_BUFFERING; val=0 ;;
                    perf=on) var=KD_PERF_LOG; val=1 ;;
                    perf=off) var=KD_PERF_LOG; val= ;;
                    lidcheck=on) var=KD_REQUIRE_LID_CLOSED; val=1 ;;
                    lidcheck=off) var=KD_REQUIRE_LID_CLOSED; val= ;;
                    cursor=default) var=KD_SW_CURSOR; val= ;;
                    cursor=sw) var=KD_SW_CURSOR; val=1 ;;
                    repaint=default) var=KD_FULL_REPAINT; val= ;;
                    repaint=full) var=KD_FULL_REPAINT; val=1 ;;
                    margin=default) var=KD_SAFETY_MARGIN; val= ;;
                    margin=[0-9]*) case $v in *[!0-9]*) die "margin must be microseconds: '$v'" ;; esac
                                   var=KD_SAFETY_MARGIN; val=$v ;;
                    *) die "unknown setting '$kv' (gpu=default|nvidia tb=default|on|off margin=default|<us> cursor=default|sw repaint=default|full perf=on|off lidcheck=on|off)" ;;
                esac
                grep -q "^$var=" "$ENVFILE" || upgrade_envfile
                sed -i "s/^$var=.*/$var=$val/" "$ENVFILE"
            done
            cmd_kwin show
            echo "-> log out and back in (docked) to apply." ;;
        show)
            echo "login script ($ENVFILE):"
            if [ -e "$ENVFILE" ]; then grep '^KD_' "$ENVFILE" | sed 's/^/  /'; else echo "  not installed (stuttertest kwin install)"; fi
            echo "running KWin (from the $(kwin_env_source)):"
            local e; e=$(kwin_env)
            if [ -n "$e" ]; then echo "  ${e//$'\n'/$'\n'  }"; else echo "  no KWIN_* variables"; fi
            echo "  render GPU: $(render_gpu)" ;;
        *) die "usage: stuttertest kwin show|install|set KEY=VALUE..." ;;
    esac
}

# ---------------------------------------------------------------- clocks

APPLIED=()
LOAD_PID=
SMI_PID=
TRACE_PID=
PM_ORIG=
CLOCK_NOTES=()

start_load() {
    # Small uncapped glxgears window; on the NVIDIA GPU (p0) or the Intel GPU (p0ctl).
    have glxgears || die "glxgears not installed (glx-utils / mesa-demos)"
    if [ "$1" = nvidia ]; then
        "$DGPU_RUN" env __GL_SYNC_TO_VBLANK=0 vblank_mode=0 glxgears -geometry 200x200 >/dev/null 2>&1 &
    else
        [ -e "$IG_RENDER" ] || die "no Intel GPU (BIOS dGPU-only mode?): p0ctl needs it"
        env __GLX_VENDOR_LIBRARY_NAME=mesa DRI_PRIME=pci-0000_00_02_0 vblank_mode=0 glxgears -geometry 200x200 >/dev/null 2>&1 &
    fi
    LOAD_PID=$!
    sleep 3
    kill -0 "$LOAD_PID" 2>/dev/null || die "glxgears exited immediately"
    echo "load on $1 GPU started (pid $LOAD_PID); NVIDIA now: $(nvidia-smi -i "$SMI_ID" --query-gpu=pstate,clocks.mem,clocks.gr --format=csv,noheader 2>/dev/null)"
}

apply_clock() {
    local item=$1 name val max
    name=${item%%=*}; val=; [ "$item" != "$name" ] && val=${item#*=}
    case $name in
        none) ;;
        mem)
            [ -n "$val" ] || val=$(nvidia-smi -i "$SMI_ID" --query-supported-clocks=memory --format=csv,noheader,nounits | tr -dc '0-9\n' | sort -n | tail -1)
            sudo nvidia-smi -i "$SMI_ID" -lmc "$val,$val" >/dev/null || die "memory lock $val failed"
            APPLIED+=(mem); CLOCK_NOTES+=("mem_lock=$val"); echo "memory clock locked at $val MHz" ;;
        gr)
            [ -n "$val" ] || val=900
            max=$(nvidia-smi -i "$SMI_ID" --query-gpu=clocks.max.graphics --format=csv,noheader,nounits | tr -dc '0-9')
            [ -n "$max" ] || die "cannot read max graphics clock"
            sudo nvidia-smi -i "$SMI_ID" -lgc "$val,$max" >/dev/null || die "graphics floor $val failed"
            APPLIED+=(gr); CLOCK_NOTES+=("gr_floor=$val-$max"); echo "graphics clock floor $val-$max MHz" ;;
        pm-consistent|pm-max)
            PM_ORIG=$("$POWERMIZER" --index "$SMI_ID" 2>/dev/null | sed -n 's/^current: //p')
            APPLIED+=(pm)
            sudo "$POWERMIZER" --index "$SMI_ID" "${name#pm-}" >/dev/null || die "PowerMizer ${name#pm-} failed"
            "$POWERMIZER" --index "$SMI_ID" 2>/dev/null | grep -q "current: ${name#pm-}" \
                || die "PowerMizer ${name#pm-} did not persist after the setting process exited: this GPU ignores it"
            CLOCK_NOTES+=("powermizer=${name#pm-} (was ${PM_ORIG:-?})"); echo "PowerMizer ${name#pm-} (was ${PM_ORIG:-?})" ;;
        p0) start_load nvidia; APPLIED+=(load); CLOCK_NOTES+=("load=nvidia") ;;
        p0ctl) start_load intel; APPLIED+=(load); CLOCK_NOTES+=("load=intel") ;;
        *) die "unknown clock setting '$item'" ;;
    esac
}

reset_clocks() {
    local a
    for a in "${APPLIED[@]}"; do
        case $a in
            mem) sudo nvidia-smi -i "$SMI_ID" -rmc >/dev/null 2>&1 ;;
            gr) sudo nvidia-smi -i "$SMI_ID" -rgc >/dev/null 2>&1 ;;
            pm) sudo "$POWERMIZER" --index "$SMI_ID" "${PM_ORIG:-adaptive}" >/dev/null 2>&1 ;;
            load) [ -n "$LOAD_PID" ] && kill "$LOAD_PID" 2>/dev/null ;;
        esac
    done
    APPLIED=()
    [ -n "$SMI_PID" ] && kill "$SMI_PID" 2>/dev/null
    SMI_PID=
    stop_trace
}

# The trace runs as root through sudo, started as a background job, which a script starts
# with SIGINT ignored: signal bpftrace itself (it installs its own SIGINT handler, prints its
# last lines and detaches), and fall back to SIGTERM. TRACE_PID is sudo's process, owned by
# root, so check it through /proc rather than kill -0.
stop_trace() {
    local i
    [ -n "$TRACE_PID" ] || return 0
    sudo -n true 2>/dev/null || { echo "stopping the kernel trace needs sudo again:"; sudo -v; }
    sudo pkill -INT -f 'bpftrace .*flipfence\.bt' 2>/dev/null
    for i in $(seq 20); do [ -d "/proc/$TRACE_PID" ] || break; sleep 0.5; done
    [ -d "/proc/$TRACE_PID" ] && sudo pkill -TERM -f 'bpftrace .*flipfence\.bt' 2>/dev/null
    for i in $(seq 10); do [ -d "/proc/$TRACE_PID" ] || break; sleep 0.5; done
    if [ -d "/proc/$TRACE_PID" ]; then
        echo "warning: the kernel trace is still running; stop it with: sudo pkill -f 'bpftrace .*flipfence'" >&2
    else
        wait "$TRACE_PID" 2>/dev/null
    fi
    TRACE_PID=
}

# CRTC index (the 'crtc' of the trace's FLIPEV lines) -> connector, from DRM's debugfs state.
crtc_map() {
    local d
    for d in $(sudo sh -c 'ls -d /sys/kernel/debug/dri/*/' 2>/dev/null); do
        sudo grep -qs "$NV_PCI" "${d}name" || continue
        sudo grep -A1 '^connector\[' "${d}state" 2>/dev/null
        return 0
    done
}

start_trace() {
    local rd=$1 bt=$HERE/../trace/flipfence.bt pid
    have bpftrace || die "bpftrace is missing: sudo dnf install bpftrace"
    pid=$(kwin_pid) || die "--trace needs KWin running"
    sudo -v || die "--trace needs sudo"
    crtc_map > "$rd/crtc-map.txt"
    sudo bpftrace "$bt" "$pid" > "$rd/trace.log" 2> "$rd/trace.err" &
    TRACE_PID=$!
    local i
    for i in $(seq 60); do   # bpftrace says "Attached N probes" once it's ready; that can take a while
        grep -qi 'attach' "$rd/trace.err" 2>/dev/null && break
        [ -d "/proc/$TRACE_PID" ] || break
        sleep 0.5
    done
    [ -d "/proc/$TRACE_PID" ] || { TRACE_PID=; die "bpftrace stopped at the start; see trace.err in ${rd}-failed"; }
    echo "kernel trace running ($(grep -i -m1 'attach' "$rd/trace.err" 2>/dev/null || echo 'no attach message yet'))"
}

cmd_reset() {
    sudo pkill -INT -f 'bpftrace .*flipfence\.bt' 2>/dev/null
    sudo nvidia-smi -i "$SMI_ID" -rmc >/dev/null 2>&1
    sudo nvidia-smi -i "$SMI_ID" -rgc >/dev/null 2>&1
    if "$POWERMIZER" --index "$SMI_ID" 2>/dev/null | grep -q '^supported:.* auto'; then
        sudo "$POWERMIZER" --index "$SMI_ID" auto >/dev/null 2>&1
    else
        sudo "$POWERMIZER" --index "$SMI_ID" adaptive >/dev/null 2>&1
    fi
    pkill -f 'glxgears -geometry 200x200' 2>/dev/null
    echo "clock locks, PowerMizer mode and test loads reset"
    [ -e /run/nvidia-clockfloor.state ] && echo "note: the nvidia-clockfloor service is active and will re-apply its own lock"
    true
}

# ---------------------------------------------------------------- run

# Wait until every frame log that has rows from this test also has rows from
# after it (KWin writes the log in chunks), up to 30 s.
wait_for_logs() {
    local t0=$1 t1=$2; shift 2
    local waited=0 ok
    while :; do
        ok=$(python3 - "$t0" "$t1" "$@" <<'EOF'
import csv, sys
t0, t1 = int(sys.argv[1]), int(sys.argv[2])
pending = 0
for p in sys.argv[3:]:
    seen = done = False
    try:
        with open(p, newline="") as f:
            for row in csv.reader(f):
                try:
                    t = int(row[0])
                except (ValueError, IndexError):
                    continue
                if t >= t0:
                    seen = True
                if t >= t1:
                    done = True
    except OSError:
        continue
    if seen and not done:
        pending += 1
print("yes" if pending == 0 else "no")
EOF
)
        [ "$ok" = yes ] && return 0
        waited=$((waited + 2))
        if [ $waited -ge 30 ]; then echo "    (log not caught up after 30 s; the last moments may be missing)"; return 0; fi
        sleep 2
    done
}

cmd_run() {
    local name='' clock=none smi='' duration='' force='' trace=''
    while [ $# -gt 0 ]; do
        case $1 in
            --clock) clock=${2:?}; shift ;;
            --smi) smi=1 ;;
            --trace) trace=1 ;;
            --duration) duration=${2:?}; shift ;;
            --force) force=1 ;;
            -*) die "unknown option $1" ;;
            *) if [ -z "$name" ]; then name=$1; else die "one NAME only"; fi ;;
        esac
        shift
    done
    [ -n "$name" ] || die "usage: stuttertest run NAME [--clock LIST] [--smi|--trace] [--duration N]"
    case $name in *[!A-Za-z0-9._-]*) die "NAME may only contain letters, digits, . _ -" ;; esac
    [ -z "$trace" ] || [ -z "$smi" ] || die "--trace and --smi in the same run would disturb each other; pick one"

    local kwin=1
    if ! kwin_pid >/dev/null; then
        [ -n "$smi" ] || die "kwin_wayland is not running in your session (outside Plasma, use --smi)"
        [ -z "$trace" ] || die "--trace needs KWin (Plasma)"
        kwin=
    elif ! kwin_env | grep -q '^KWIN_LOG_PERFORMANCE_DATA=1'; then
        die "KWin frame logging is off (no KWIN_LOG_PERFORMANCE_DATA=1 in the $(kwin_env_source)). Run 'stuttertest kwin set perf=on', make sure the Dells are connected, then log out and back in. 'stuttertest info' shows the details."
    fi
    if [ -e /run/nvidia-clockfloor.state ] && [ -z "$force" ]; then
        die "the nvidia-clockfloor service holds a lock ($(cat /run/nvidia-clockfloor.state)); pause it or use --force"
    fi
    local c
    IFS=, read -r -a clocks <<< "$clock"
    for c in "${clocks[@]}"; do
        case ${c%%=*} in none|mem|gr|pm-consistent|pm-max|p0|p0ctl) ;; *) die "unknown clock setting '$c'" ;; esac
        case $c in *=*[!0-9]*) die "clock value must be a number of MHz: '$c'" ;; esac
    done
    case ,$clock, in *,mem*|*,gr*|*,pm-*) sudo -v || die "sudo needed for clock settings" ;; esac

    mkdir -p "$DATA/runs"
    local n rd
    n=$(find "$DATA/runs" -mindepth 1 -maxdepth 1 -type d | wc -l)
    rd=$(printf '%s/runs/%03d-%s' "$DATA" $((n + 1)) "$name")
    mkdir -p "$rd"

    local tb gpu margin kcfg drv gsp ctx
    tb=$(kwin_env | sed -n 's/^KWIN_DRM_DISABLE_TRIPLE_BUFFERING=//p')
    case $tb in 0) tb=on ;; 1) tb=off ;; *) tb=default ;; esac
    margin=$(kwin_env | sed -n 's/^KWIN_DRM_OVERRIDE_SAFETY_MARGIN=//p')
    if [ -n "$kwin" ]; then
        kcfg="tb=$tb${margin:+,margin=$margin}"
        kwin_env | grep -q '^KWIN_FORCE_SW_CURSOR=1' && kcfg="$kcfg,swcursor"
        kwin_env | grep -q '^KWIN_USE_BUFFER_AGE=0' && kcfg="$kcfg,fullrepaint"
        gpu=$(render_gpu | cut -c1-40)
    else
        kcfg="no-kwin:${XDG_CURRENT_DESKTOP:-?}"
        gpu=-
    fi
    gsp=$(gsp_state)
    drv="$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null)/$(module_type)/gsp-${gsp%% *}/vblank=$(drm_param vblank)"
    ctx="kwin=$(kwin_version),kernel=$(uname -r),lid=$(lid_state),powerd=$(powerd_state)"
    {
        echo "name=$name"; echo "date=$(date -Is)"; echo "clock=$clock"; echo "kwin_config=$kcfg"; echo "render_gpu=$gpu"
        echo "driver=$drv"; echo "context=$ctx"; echo "gsp=$gsp"; echo "power_profile=$(power_profile)"
        echo "docked=$(docked && echo yes || echo no)"; echo "ac=$(systemd-ac-power 2>/dev/null && echo yes || echo no)"
        echo "session=${XDG_CURRENT_DESKTOP:-?}"
        kwin_env | sed 's/^/env:/'
    } > "$rd/meta.txt"

    RUN_DIR=$rd RUN_DONE=
    trap 'reset_clocks; finish_run' EXIT
    trap 'echo; echo "interrupted"; exit 130' INT TERM
    for c in "${clocks[@]}"; do apply_clock "$c"; done
    for c in "${CLOCK_NOTES[@]}"; do echo "applied:$c" >> "$rd/meta.txt"; done

    [ -n "$trace" ] && start_trace "$rd"
    if [ -n "$smi" ]; then
        nvidia-smi -i "$SMI_ID" --query-gpu=timestamp,pstate,clocks.mem,clocks.gr,power.draw --format=csv,noheader,nounits -lms 500 > "$rd/smi.csv" 2>/dev/null &
        SMI_PID=$!
    fi

    local t0 t1 t0wall
    read -r t0 t0wall < <(python3 -c 'import time; print(time.monotonic_ns(), time.time())')
    { echo "t0_mono_ns=$t0"; echo "t0_wall=$t0wall"; } >> "$rd/meta.txt"
    echo
    echo ">>> Test '$name' running: do the routine (TESTBED.md section 4) on the docked monitors."
    local line rc end
    if [ -n "$duration" ]; then
        [ -t 0 ] && echo "    Static or blanking? Hit your mark shortcut (works mid-drag), or press Enter here after letting go."
        end=$((SECONDS + duration))
        while [ $SECONDS -lt "$end" ]; do
            printf '\r    %3ds left ' $((end - SECONDS))
            if [ -t 0 ]; then
                read -r -t 1 line; rc=$?
                if [ $rc -eq 0 ]; then add_mark "${line:-static}"; elif [ $rc -le 128 ]; then sleep 1; fi
            else
                sleep 1
            fi
        done
        printf '\a\n'
    else
        while read -r -p "    Press Enter when done (m + Enter marks static). " line && [ -n "$line" ]; do
            add_mark "$line"
        done
    fi
    t1=$(mono_ns)
    reset_clocks
    local t1wall x11
    t1wall=$(python3 -c 'import time; print(time.time())')
    x11=$(x11_apps)
    echo "x11_apps=$x11" >> "$rd/meta.txt"
    [ -e "$DATA/marks.log" ] && awk -v a="$t0" -v b="$t1" '$1 >= a && $1 <= b' "$DATA/marks.log" > "$rd/marks.txt"
    [ -s "$rd/marks.txt" ] || rm -f "$rd/marks.txt"
    if have journalctl; then
        journalctl -q -k --since "@${t0wall%.*}" --until "@$(( ${t1wall%.*} + 1 ))" -o short-monotonic --no-pager > "$rd/kernel.log" 2>/dev/null
        journalctl -q --user -u plasma-kwin_wayland.service --since "@${t0wall%.*}" --until "@$(( ${t1wall%.*} + 1 ))" -o short-monotonic --no-pager > "$rd/kwin.log" 2>/dev/null
    fi

    local files=() f out
    if [ -n "$kwin" ]; then
        mapfile -t files < <(kwin_csv_files)
        echo ">>> Keep dragging a window across BOTH monitors for a few seconds while KWin writes its log..."
        [ ${#files[@]} -gt 0 ] && wait_for_logs "$t0" "$t1" "${files[@]}"
        printf '\a'; echo ">>> Done, you can stop."
        for f in "${files[@]}"; do
            out="$rd/perf-$(basename "$f" | sed 's/^kwin perf statistics //')"
            python3 - "$f" "$out" "$t0" "$t1" <<'EOF'
import csv, sys
src, dst, t0, t1 = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
with open(src, newline="") as f, open(dst, "w", newline="") as g:
    r = csv.reader(f)
    w = csv.writer(g)
    header = next(r, None)
    if header:
        w.writerow(header)
        for row in r:
            try:
                if t0 <= int(row[0]) <= t1:
                    w.writerow(row)
            except (ValueError, IndexError):
                pass
EOF
        done
    fi

    local stutter corruption note
    stutter=$(ask_yes_no ">>> Stutter seen during the test? [y/n, Enter = not sure] ")
    corruption=$(ask_yes_no ">>> Static/corruption seen? [y/n, Enter = not sure] ")
    read -r -p ">>> Note (optional, one line): " note
    note=${note//$'\t'/ }
    { echo "stutter=$stutter"; echo "corruption=$corruption"; echo "note=$note"; } >> "$rd/meta.txt"

    local pstates=-
    if [ -s "$rd/smi.csv" ]; then
        pstates=$(python3 - "$rd/smi.csv" <<'EOF'
import collections, sys
ps = collections.Counter(); mem = []
for line in open(sys.argv[1]):
    parts = [p.strip() for p in line.split(",")]
    if len(parts) >= 3:
        ps[parts[1]] += 1
        mem.append(parts[2])
total = sum(ps.values()) or 1
changes = sum(1 for a, b in zip(mem, mem[1:]) if a != b)
print(" ".join(f"{k}:{100 * v // total}%" for k, v in sorted(ps.items())) + f" memchg:{changes}")
EOF
)
    fi

    local clockcol=$clock
    [ ${#CLOCK_NOTES[@]} -gt 0 ] && clockcol="$clock ($(IFS=';'; echo "${CLOCK_NOTES[*]}"))"
    [ -e "$DATA/results.tsv" ] || printf 'run\tname\tclock\tkwin\tdriver\trender_gpu\toutput\tframes\tlate\tlate%%\tmissed\trender_p95%%\trender_max%%\tvrr_frames\ttb_frames%%\tstutter\tcorruption\tpstates\tcontext\tnote\n' > "$DATA/results.tsv"
    echo
    echo "=== $(basename "$rd")  clock=$clockcol  kwin=$kcfg  gpu=$gpu  driver=$drv  stutter=$stutter  corruption=$corruption"
    local any='' line runno
    runno=$(basename "$rd" | cut -d- -f1)
    for f in "$rd"/perf-*.csv; do
        [ -e "$f" ] || continue
        any=1
        "$SUMMARY" "$f"
        line=$("$SUMMARY" --tsv "$f")
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$runno" "$name" "$clockcol" "$kcfg" "$drv" "$gpu" "$line" "$stutter" "$corruption" "$pstates" "$ctx" "$note" >> "$DATA/results.tsv"
    done
    if [ -z "$any" ]; then
        [ -n "$kwin" ] && echo "no KWin frame log found"
        printf '%s\t%s\t%s\t%s\t%s\t%s\t-\t-\t-\t-\t-\t-\t-\t-\t-\t%s\t%s\t%s\t%s\t%s\n' "$runno" "$name" "$clockcol" "$kcfg" "$drv" "$gpu" "$stutter" "$corruption" "$pstates" "$ctx" "$note" >> "$DATA/results.tsv"
    fi
    if grep -q ',1,[01],[0-9]*$' "$rd"/perf-*.csv 2>/dev/null; then
        echo "note: some frames used adaptive sync; set Adaptive Sync to Never for triple-buffering comparisons"
    fi
    [ "$pstates" != - ] && echo "nvidia-smi: $pstates"
    echo "X11 apps open: $x11"
    [ -s "$rd/trace.log" ] && echo "kernel trace: $(grep -c . "$rd/trace.log") lines (trace.log; CRTC map in crtc-map.txt; bpftrace messages in trace.err)"
    [ -s "$rd/marks.txt" ] && echo "static marked: $(wc -l < "$rd/marks.txt") times"
    local lg
    for lg in kernel kwin; do
        [ -s "$rd/$lg.log" ] && echo "$lg log during the run: $(wc -l < "$rd/$lg.log") lines (saved in the run folder)"
    done
    [ -n "$any" ] && { echo "--- details"; "$ANALYZE" "$rd" | tail -n +2; }
    echo "saved: $rd"
    RUN_DONE=1
}

ask_yes_no() {
    local a
    while :; do
        read -r -p "$1" a
        case $a in [yY]*) echo yes; return ;; [nN]*) echo no; return ;; '') echo '?'; return ;; esac
    done
}

# A run that stops before its results are saved is kept, renamed *-failed.
finish_run() {
    if [ -n "${RUN_DIR:-}" ] && [ -z "${RUN_DONE:-}" ] && [ -d "$RUN_DIR" ]; then
        mv "$RUN_DIR" "$RUN_DIR-failed" && echo "run not completed: $RUN_DIR-failed"
    fi
}

cmd_mark() { add_mark "$@"; }

cmd_analyze() {
    local rd
    case ${1:-} in
        '') rd=$(ls -d "$DATA"/runs/[0-9]*/ 2>/dev/null | tail -1) ;;
        */*) rd=$1 ;;
        *) rd=$(ls -d "$DATA/runs/$1"*/ "$DATA/runs/"[0-9]*-"$1"/ 2>/dev/null | tail -1) ;;
    esac
    [ -n "$rd" ] && [ -d "$rd" ] || die "no such run: ${1:-(none yet)}"
    "$ANALYZE" "$rd"
}

cmd_report() {
    [ -e "$DATA/results.tsv" ] || die "no runs yet"
    if have column; then column -t -s $'\t' "$DATA/results.tsv"; else cat "$DATA/results.tsv"; fi
}

case ${1:-} in
    info) cmd_info ;;
    kwin) shift; cmd_kwin "$@" ;;
    run) shift; cmd_run "$@" ;;
    report) cmd_report ;;
    analyze) shift; cmd_analyze "$@" ;;
    mark) shift; cmd_mark "$@" ;;
    reset) cmd_reset ;;
    *) sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
